// claude-stick: WiFi credentials template.
//
// Copy this file to secrets.h (same directory) and fill in the SSID and
// password for the network the stick should connect to. secrets.h is
// gitignored; this template is committed so the build always has a
// reference to copy from.
//
// On Debian:
//   cp firmware/src/secrets.h.example firmware/src/secrets.h
//   $EDITOR firmware/src/secrets.h

#pragma once

#define WIFI_SSID  "your-network-name"
#define WIFI_PASS  "your-password"
